# Copy this file to .env and fill in the provider you want to use.
# With none of these set, the exception-resolution and Q&A layers fall
# back to a deterministic offline heuristic -- the app runs fully
# without any key.

# Recommended default: Groq (console.groq.com/keys) -- avoids the
# 15 req/min free-tier ceiling that was actually hit against Gemini
# during testing, and once warm is fast enough that more of a batch's
# LLM-deferred cases finish within the response time budget. Its own
# free tier caps out around 6000-8000 tokens/minute regardless of model,
# which the candidate-narrowing in matcher._narrow_llm_candidates and
# max_retries=0 in llm_resolver.py are both there to work within.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Alternative providers -- switch LLM_PROVIDER to use one of these instead.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-lite-latest
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
