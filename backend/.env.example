# Copy this file to .env and fill in the provider you want to use.
# With none of these set, the exception-resolution and Q&A layers fall
# back to a deterministic offline heuristic -- the app runs fully
# without any key.

# Recommended default: Groq (console.groq.com/keys) -- a free-tier rate
# limit well above Gemini's 15 req/min, and fast enough that more of a
# batch's LLM-deferred cases finish within the response time budget
# instead of falling back to the offline heuristic.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Alternative providers -- switch LLM_PROVIDER to use one of these instead.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-lite-latest
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
